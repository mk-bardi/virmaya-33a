<?xml version="1.0"?>
<sdf version="1.9">
  <world name="showroom">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.75 0.8 0.86 1</background><grid>false</grid><sky></sky></scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>1 0.97 0.92 1</diffuse><specular>0.4 0.4 0.4 1</specular>
      <intensity>1.3</intensity><direction>-0.4 0.5 -0.8</direction>
    </light>
    <model name="floor"><static>true</static><link name="l">
      <collision name="c"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>40 40 0.1</size></box></geometry></collision>
      <visual name="v"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>40 40 0.1</size></box></geometry>
        <material><ambient>0.55 0.56 0.55 1</ambient><diffuse>0.55 0.56 0.55 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <include><uri>model://virmaya</uri><pose>0 0 0.45 0 0 0</pose></include>
  </world>
</sdf>
