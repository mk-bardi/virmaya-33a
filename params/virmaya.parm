# Virmaya-33A hybrid VTOL quadplane, ArduPlane SITL with Gazebo Harmonic (ardupilot_gazebo, JSON backend)
# Load with: sim_vehicle.py -v ArduPlane --model JSON --add-param-file=<this file>
Q_ENABLE 1
Q_FRAME_CLASS 1
Q_FRAME_TYPE 1
# outputs (plugin channel N = SERVO N+1)
SERVO1_FUNCTION 4
SERVO2_FUNCTION 79
SERVO3_FUNCTION 70
SERVO4_FUNCTION 80
SERVO5_FUNCTION 33
SERVO6_FUNCTION 34
SERVO7_FUNCTION 35
SERVO8_FUNCTION 36
SERVO9_FUNCTION 6
SERVO10_FUNCTION 7
SERVO11_FUNCTION 8
SERVO1_MIN 1100
SERVO1_MAX 1900
SERVO2_MIN 1100
SERVO2_MAX 1900
SERVO3_MIN 1100
SERVO3_MAX 1900
SERVO4_MIN 1100
SERVO4_MAX 1900
SERVO9_MIN 1100
SERVO9_MAX 1900
SERVO10_MIN 1100
SERVO10_MAX 1900
SERVO11_MIN 1100
SERVO11_MAX 1900
# quad motors: sim thrust is quadratic in command
Q_M_PWM_TYPE 0
Q_M_PWM_MIN 1100
Q_M_PWM_MAX 1900
Q_M_SPIN_ARM 0.08
Q_M_SPIN_MIN 0.12
Q_M_THST_EXPO 1.0
Q_M_THST_HOVER 0.5
Q_TRANSITION_MS 5000
Q_ASSIST_SPEED 12
# no airspeed sensor in the plugin
ARSPD_TYPE 0
AIRSPEED_MIN 15
AIRSPEED_CRUISE 19
AIRSPEED_MAX 26
ARSPD_FBW_MIN 15
ARSPD_FBW_MAX 26
TRIM_ARSPD_CM 1900
# SIYI A8 mini as a servo gimbal
MNT1_TYPE 1
MNT1_PITCH_MIN -90
MNT1_PITCH_MAX 30
MNT1_YAW_MIN -135
MNT1_YAW_MAX 135
MNT1_ROLL_MIN -30
MNT1_ROLL_MAX 30
# SITL with Gazebo: one IMU, no terrain download
INS_ENABLE_MASK 1
TERRAIN_ENABLE 0
