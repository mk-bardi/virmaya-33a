        <inertia><ixx>1.8000e-4</ixx><ixy>0.0000e+0</ixy><ixz>0.0000e+0</ixz><iyy>1.8000e-4</iyy><iyz>0.0000e+0</iyz><izz>3.6000e-4</izz></inertia>
