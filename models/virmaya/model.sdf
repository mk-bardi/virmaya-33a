        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="leg_0">
        <pose>0.449 -0.31 -0.1685 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.004</radius><length>0.285</length></cylinder>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="foot_0">
        <pose>0.449 -0.31 -0.305 0 0 0</pose>
        <geometry>
          <sphere><radius>0.006</radius></sphere>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
