<?xml version="1.0"?>
<!-- Virmaya-33A hybrid VTOL quadplane (drawing MMB-GA-0001), Muhammad Mukhtar Bardi.
     Gazebo Harmonic + ArduPilot SITL (ardupilot_gazebo ArduPilotPlugin, JSON backend).
     Ported from the Gazebo Classic URDF (quadplane_description). Mass, inertia, joints and
     lift-drag coefficients are unchanged. base_link origin = CG. X forward, Y left, Z up. SI units. -->
<sdf version="1.9">
  <model name="virmaya">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0.0024 0 0.0001 0 0 0</pose>
        <mass>5.175</mass>
        <inertia><ixx>3.8718e-1</ixx><ixy>5.4410e-7</ixy><ixz>1.6989e-2</ixz><iyy>5.4730e-1</iyy><iyz>-6.5747e-7</iyz><izz>8.9914e-1</izz></inertia>
      </inertial>
      <visual name="base_skin">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_skin.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_carbon">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_carbon.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_pla">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_pla.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_steel">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_steel.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_dark">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_dark.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_red">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_red.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_yellow">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_yellow.dae</uri></mesh>
        </geometry>
      </visual>
      <visual name="base_white">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://virmaya/meshes/base_white.dae</uri></mesh>
        </geometry>
      </visual>
      <collision name="fuselage">
        <pose>0.114 0 -0.0375 0 0 0</pose>
        <geometry>
          <box><size>0.73 0.17 0.195</size></box>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="wing">
        <pose>-0.081 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.26 1.9 0.03</size></box>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="boom_left">
        <pose>-0.296 0.31 -0.011 0 0 0</pose>
        <geometry>
          <box><size>1.54 0.02 0.02</size></box>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="boom_right">
